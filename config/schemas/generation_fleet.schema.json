{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ecuador-electric-grid/generation-fleet.schema.json",
  "title": "Normalized 2022 SNI generator row",
  "type": "object",
  "required": [
    "plant_id",
    "source_row",
    "name",
    "province",
    "carrier",
    "p_nom_mw",
    "effective_capacity_mw",
    "latitude",
    "longitude",
    "location_method",
    "source_document_id",
    "source_locator",
    "operating_start_date_2022",
    "operating_start_basis",
    "baseline_status"
  ],
  "properties": {
    "plant_id": {"type": "string", "pattern": "^ec2022_[0-9]{3}_"},
    "source_row": {"type": "integer", "minimum": 2},
    "name": {"type": "string", "minLength": 1},
    "province": {"type": "string", "minLength": 1},
    "carrier": {"enum": ["hydro", "oil", "biomass", "biogas", "solar", "onwind"]},
    "p_nom_mw": {"type": "number", "minimum": 0},
    "effective_capacity_mw": {"type": "number", "minimum": 0},
    "latitude": {"type": "number", "minimum": -5.5, "maximum": 2.0},
    "longitude": {"type": "number", "minimum": -81.5, "maximum": -74.5},
    "location_method": {"enum": ["exact_2017", "manual_legacy", "capacity_proxy_2017", "verified_mapped_location"]},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "operating_start_date_2022": {"type": "string", "pattern": "^2022-[0-9]{2}-[0-9]{2}"},
    "operating_start_basis": {"enum": ["existing_inventory_full_year_assumption", "cenace_2022_commissioning_event"]},
    "baseline_status": {"const": "existing_2022"}
  },
  "additionalProperties": true
}
