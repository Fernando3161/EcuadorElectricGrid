{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_manifest.schema.json",
  "title": "External artifact manifest",
  "type": "object",
  "required": ["manifest_version", "project", "record", "stages", "artifacts"],
  "properties": {
    "manifest_version": {"type": "integer", "minimum": 1},
    "project": {"type": "string", "minLength": 1},
    "record": {
      "type": "object",
      "required": ["title", "version", "doi", "record_url", "license"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1},
        "record_url": {"type": "string", "pattern": "^https://"},
        "license": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "depends_on"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "stages",
          "destination",
          "role",
          "source",
          "persistent_uri",
          "download_url",
          "bytes",
          "sha256",
          "media_type",
          "license",
          "validation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "stages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "destination": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"},
          "role": {"enum": ["source", "external_input", "generated_product"]},
          "source": {"type": "object"},
          "persistent_uri": {"type": "string", "pattern": "^https://"},
          "availability": {"enum": ["external", "repository"]},
          "download_url": {
            "anyOf": [
              {"type": "string", "pattern": "^https://"},
              {"type": "null"}
            ]
          },
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "license": {"type": "string"},
          "validation": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["checksum_only", "netcdf"]},
              "dimensions": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": 0}
              },
              "required_variables": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "attributes": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
