{
  "schema_version": 1,
  "phase": "01",
  "purpose": "Evidence-preserving classification of the pre-refactor repository. Classification is not scientific validation.",
  "classification_terms": {
    "governance": "Project policy, documentation, reports, schemas, or tests.",
    "candidate_active": "Candidate input, notebook, or code for reconstruction of the supported workflow; not yet canonical.",
    "manual_evidence": "Manual repair, matching, or extraction evidence that must be migrated before cleanup.",
    "generated_candidate": "Derived output whose writer is known but whose reproducibility or validity is not yet accepted.",
    "legacy_evidence": "Historical implementation or result retained to recover scientific logic and provenance.",
    "mixed_official_and_hypothetical": "Artifact combining official-plan candidates with modeling assumptions; quarantined from official use.",
    "hypothetical_scenario": "Explicit non-official scenario material, excluded from the baseline and official plan tables.",
    "experimental_result": "Non-canonical result retained as diagnostic evidence.",
    "external_required": "Upstream artifact required by the supported workflow and destined for checksum-pinned retrieval.",
    "external_optional": "External or local evidence not required by the supported student workflow.",
    "authoritative_source": "Versioned official source data accepted for the supported scientific workflow."
  },
  "tracked_file_rules": [
    {
      "id": "root_governance",
      "patterns": [".gitignore", "AGENTS.md", "LICENSE", "README.md"],
      "classification": "governance",
      "disposition": "retain"
    },
    {
      "id": "phase_documents",
      "patterns": ["docs/*.md", "reports/*.md"],
      "classification": "governance",
      "disposition": "retain"
    },
    {
      "id": "phase_contracts",
      "patterns": ["config/artifacts.yaml", "config/repository_inventory.json", "config/validation_2022.yaml", "config/schemas/*.json"],
      "classification": "governance",
      "disposition": "retain"
    },
    {
      "id": "legacy_runtime_configuration",
      "patterns": ["config/config.yaml"],
      "classification": "legacy_evidence",
      "disposition": "reconcile in Phase 2 before supported use"
    },
    {
      "id": "supported_environment_specification",
      "patterns": ["config/environment_ec.yaml"],
      "classification": "candidate_active",
      "disposition": "reconciled against the approved environment in Phase 2; retain as an auditable specification"
    },
    {
      "id": "current_2022_notebooks",
      "patterns": ["notebooks/*.ipynb", "notebooks/*.py"],
      "classification": "candidate_active",
      "disposition": "rewrite into the staged notebook series after logic extraction"
    },
    {
      "id": "notebook_directory_outputs",
      "patterns": ["notebooks/*.csv", "notebooks/*.json"],
      "classification": "generated_candidate",
      "disposition": "map writers and migrate reproducible outputs out of notebooks; do not delete yet"
    },
    {
      "id": "legacy_notebooks",
      "patterns": ["notebooks/_alt/*"],
      "classification": "legacy_evidence",
      "disposition": "retain through migration; review for Phase 10 pruning"
    },
    {
      "id": "candidate_source_modules",
      "patterns": ["src/*.py"],
      "classification": "candidate_active",
      "disposition": "retain and extract tested functions incrementally"
    },
    {
      "id": "migration_scripts",
      "patterns": ["scripts/*.py"],
      "classification": "manual_evidence",
      "disposition": "retain deterministic evidence migrations until their source workbooks are formally archived"
    },
    {
      "id": "premature_scenario_registry",
      "patterns": ["src/scenario_registry.json"],
      "classification": "legacy_evidence",
      "disposition": "quarantine until the validated baseline and future-scenario contract exist"
    },
    {
      "id": "legacy_source_modules",
      "patterns": ["src/_old/*.py"],
      "classification": "legacy_evidence",
      "disposition": "retain through logic extraction; review for Phase 10 pruning"
    },
    {
      "id": "current_raw_demand_tables",
      "patterns": ["data/raw/demand/*.csv"],
      "classification": "candidate_active",
      "disposition": "verify source edition, units, and lineage in Phase 3"
    },
    {
      "id": "official_2022_statistical_reference",
      "patterns": ["data/raw/statistics/*.csv"],
      "classification": "authoritative_source",
      "disposition": "retain as source-faithful official statistics with row-level locators"
    },
    {
      "id": "legacy_raw_demand_tables",
      "patterns": ["data/raw/demand/_alt/*.csv"],
      "classification": "legacy_evidence",
      "disposition": "retain as 2018-chain evidence"
    },
    {
      "id": "current_raw_geography_tables",
      "patterns": ["data/raw/gadm/*.csv"],
      "classification": "candidate_active",
      "disposition": "verify source and role before normalization"
    },
    {
      "id": "current_raw_generation_tables",
      "patterns": ["data/raw/generation/carriers.csv", "data/raw/generation/caudals.csv", "data/raw/generation/technology_cost.csv", "data/raw/generation/generation_existing_2022.csv", "data/raw/generation/cenace_2022_commissioning_events.csv", "data/raw/generation/plant_location_overrides_2022.csv"],
      "classification": "candidate_active",
      "disposition": "retain the Phase 4 source transcription and supporting parameter tables with explicit provenance status"
    },
    {
      "id": "generation_interim_evidence",
      "patterns": ["data/interim/generation/*.csv"],
      "classification": "manual_evidence",
      "disposition": "retain selected one-to-one location and hydro assignment evidence used by the supported Phase 4 workflow"
    },
    {
      "id": "network_interim_evidence",
      "patterns": ["data/interim/network/*.csv", "data/interim/network/*.json"],
      "classification": "generated_candidate",
      "disposition": "retain Phase 5 repair, mutation, component, attachment, and fingerprint evidence until scientific validation and final pruning review"
    },
    {
      "id": "legacy_generation_mapping",
      "patterns": ["data/raw/generation/_alt/*.json"],
      "classification": "legacy_evidence",
      "disposition": "retain until carrier mapping is migrated to the Phase 3 validation contract"
    },
    {
      "id": "mixed_future_generation_table",
      "patterns": ["data/raw/generation/generation_future_renewable_2022.csv"],
      "classification": "mixed_official_and_hypothetical",
      "disposition": "split official rows from nuclear assumptions before any Master Plan use"
    },
    {
      "id": "mixed_master_plan_network_tables",
      "patterns": ["data/raw/networks/EC_bus_expansion_check.csv", "data/raw/networks/EC_bus_expansion_masterplan_2022.csv", "data/raw/networks/EC_line_expansion_masterplan_2022.csv"],
      "classification": "mixed_official_and_hypothetical",
      "disposition": "quarantine; normalize cited official rows and separate auto-generated nuclear rows in Phase 8"
    },
    {
      "id": "transformer_master_plan_candidate",
      "patterns": ["data/raw/networks/EC_transformer_expansion_masterplan_2022.csv"],
      "classification": "manual_evidence",
      "disposition": "preserve and add row-level source provenance in Phase 8"
    },
    {
      "id": "current_demand_products",
      "patterns": ["data/processed/demand/*.csv"],
      "classification": "generated_candidate",
      "disposition": "reproduce and validate in Phase 3"
    },
    {
      "id": "normalized_2022_statistics",
      "patterns": ["data/processed/statistics/*.csv"],
      "classification": "generated_candidate",
      "disposition": "retain as the reproducible normalized interface generated from the authoritative Phase 3 source table"
    },
    {
      "id": "hydro_profile_products_and_audits",
      "patterns": ["data/processed/generation/hidro_max_profiles/*.csv"],
      "classification": "manual_evidence",
      "disposition": "preserve aliases, match diagnostics, and generated profiles; normalize naming in Phase 4"
    },
    {
      "id": "hypothetical_nuclear_layout",
      "patterns": ["data/processed/generation/nuclear_layout.csv"],
      "classification": "hypothetical_scenario",
      "disposition": "exclude from baseline and official Master Plan; retain only as legacy evidence"
    },
    {
      "id": "processed_generation_candidates",
      "patterns": ["data/processed/generation/powerplants_existing.csv", "data/processed/generation/renewable_energy_generation.csv", "data/processed/generation/generators_2022.csv"],
      "classification": "generated_candidate",
      "disposition": "retain the normalized Phase 4 fleet; legacy candidates remain evidence until Phase 10"
    },
    {
      "id": "mixed_processed_generation_candidates",
      "patterns": ["data/processed/generation/powerplants_all.csv", "data/processed/generation/powerplants_future.csv"],
      "classification": "mixed_official_and_hypothetical",
      "disposition": "do not use as official planning tables; separate nuclear assumptions during reconstruction"
    },
    {
      "id": "current_network_repairs",
      "patterns": ["data/processed/networks/line_fix.csv"],
      "classification": "manual_evidence",
      "disposition": "migrate to tested repair rules with rationale in Phase 5"
    },
    {
      "id": "legacy_network_repairs",
      "patterns": ["data/processed/networks/_alt/*.csv"],
      "classification": "legacy_evidence",
      "disposition": "compare with current repairs before Phase 10"
    },
    {
      "id": "legacy_scenario_design",
      "patterns": ["literature/scenario_deve_documentation.md"],
      "classification": "hypothetical_scenario",
      "disposition": "retain as legacy design evidence; do not present as an official plan"
    },
    {
      "id": "official_cenace_reports",
      "patterns": ["literature/CENACE/*.pdf"],
      "classification": "authoritative_source",
      "disposition": "retain as checksum-recorded primary evidence for the 2022 validation contract"
    },
    {
      "id": "experimental_results",
      "patterns": ["results/experiments/*.csv"],
      "classification": "experimental_result",
      "disposition": "retain as diagnostic evidence; not a canonical result"
    },
    {
      "id": "phase_tests",
      "patterns": ["tests/*.py"],
      "classification": "governance",
      "disposition": "retain"
    },
    {
      "id": "phase_validation_figures",
      "patterns": ["reports/figures/*/*.png"],
      "classification": "generated_candidate",
      "disposition": "retain when generated by the supported notebooks and referenced as validation evidence in a phase report"
    }
  ],
  "ignored_artifact_rules": [
    {
      "id": "ignored_supported_demand_product",
      "patterns": ["data/processed/demand/demand_profiles_2022_mw.csv"],
      "classification": "generated_candidate",
      "disposition": "regenerate with the supported Phase 3 notebook; do not commit the large derived profile"
    },
    {
      "id": "ignored_supported_generation_profiles",
      "patterns": ["data/processed/generation/hydro_availability_2022.csv", "data/processed/generation/renewable_availability_2022.csv"],
      "classification": "generated_candidate",
      "disposition": "regenerate with the supported Phase 4 profile notebook; do not commit the large derived profiles"
    },
    {
      "id": "ignored_demand_scenario_products",
      "patterns": ["data/processed/demand/_ALT/*.csv"],
      "classification": "legacy_evidence",
      "disposition": "retain until demand-scenario formulas and required examples are migrated"
    },
    {
      "id": "ignored_generation_workbook_products",
      "patterns": ["data/processed/generation/*.xlsx"],
      "classification": "generated_candidate",
      "disposition": "reproduce as normalized open tables in Phase 4"
    },
    {
      "id": "ignored_current_generated_networks",
      "patterns": ["data/processed/networks/ec_network_2022.nc", "data/processed/networks/network_base_filled.nc"],
      "classification": "generated_candidate",
      "disposition": "do not publish as inputs; reproduce in Phase 5"
    },
    {
      "id": "ignored_untraced_network_original",
      "patterns": ["data/processed/networks/network_original.nc"],
      "classification": "legacy_evidence",
      "disposition": "trace before Phase 10"
    },
    {
      "id": "ignored_legacy_processed_networks",
      "patterns": ["data/processed/networks/_alt/*.nc"],
      "classification": "legacy_evidence",
      "disposition": "retain until topology and scenario logic migrate"
    },
    {
      "id": "ignored_required_renewable_profiles",
      "patterns": ["data/raw/cutouts/solar.nc", "data/raw/cutouts/onwind.nc"],
      "classification": "external_required",
      "disposition": "published and verified; manifest and checksum-pin in Phase 2"
    },
    {
      "id": "ignored_optional_full_cutout",
      "patterns": ["data/raw/cutouts/cutout-2013-era5.nc"],
      "classification": "external_optional",
      "disposition": "exclude from student workflow; retain in companion data project"
    },
    {
      "id": "ignored_geography_sources",
      "patterns": ["data/raw/gadm/*.xlsx", "data/raw/gadm/*.gpkg"],
      "classification": "external_optional",
      "disposition": "record source/license and manifest if a supported stage requires it"
    },
    {
      "id": "ignored_generation_source_workbooks",
      "patterns": ["data/raw/generation/*.xlsx"],
      "classification": "external_optional",
      "disposition": "preserve and record source/license before Phase 4"
    },
    {
      "id": "ignored_legacy_generation_material",
      "patterns": ["data/raw/generation/_alt/*"],
      "classification": "legacy_evidence",
      "disposition": "retain until generation lineage and unique content are resolved"
    },
    {
      "id": "ignored_required_base_network",
      "patterns": ["data/raw/networks/base.nc"],
      "classification": "external_required",
      "disposition": "published and verified; manifest and checksum-pin in Phase 2"
    },
    {
      "id": "ignored_other_raw_networks",
      "patterns": ["data/raw/networks/elec*.nc"],
      "classification": "legacy_evidence",
      "disposition": "upstream/intermediate evidence; exclude from supported preflight unless provenance proves a need"
    },
    {
      "id": "ignored_legacy_raw_network_tables",
      "patterns": ["data/raw/networks/_alt/*.csv", "data/raw/networks/backups/*.csv"],
      "classification": "legacy_evidence",
      "disposition": "compare with current planning tables before Phase 10"
    },
    {
      "id": "ignored_master_plan_sources",
      "patterns": ["literature/PlanMaestroElectrifEc/*"],
      "classification": "external_optional",
      "disposition": "preserve; decide licensing/distribution and capture row-level citations"
    },
    {
      "id": "ignored_legacy_source_editions",
      "patterns": ["literature/_old/*.pdf"],
      "classification": "legacy_evidence",
      "disposition": "retain until its edition relationship is documented"
    },
    {
      "id": "ignored_experimental_network_results",
      "patterns": ["results/networks/*.nc"],
      "classification": "experimental_result",
      "disposition": "retain locally as non-canonical solve evidence; review for Phase 10"
    },
    {
      "id": "ignored_generated_figures",
      "patterns": ["results/graphs/*.png", "results/graphs/demand/*.png", "results/graphs/generation/*.png"],
      "classification": "generated_candidate",
      "disposition": "regenerate selected validation figures into reports/figures; review the remainder in Phase 10"
    },
    {
      "id": "ignored_runtime_logs",
      "patterns": ["logs.log", "results/scenario_runs.log"],
      "classification": "experimental_result",
      "disposition": "retain only while needed for forensic tracing; replace with run-scoped logs"
    }
  ],
